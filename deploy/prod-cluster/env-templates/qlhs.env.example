# =========================================================================
# QLHS — .env PROD cho cụm 8443. Copy sang ~/QLHS_DE/.env (GỐC repo, KHÔNG phải apps/api/.env), KHÔNG commit.
# LƯU Ý: compose QLHS đã override sẵn DATABASE_URL, NODE_ENV=production, PORT, SMTP
# (→ mailpit) — nên ở đây CHỈ cần điền OIDC + local admin. Các dòng đó không cần.
# =========================================================================

# ---- DB (bản siết bảo mật — mật khẩu mạnh, CHỈ [A-Za-z0-9], sinh bằng gen-secrets.sh) ----
# 50-qlhs-up.sh / update-qlhs.sh đọc 2 dòng này ra shell cho compose. superuser 'qlhs'
# + app-role 'qlhs_app' đều dùng mật khẩu mạnh (thay giá trị mặc định yếu).
POSTGRES_PASSWORD=CHANGE_ME_pg_superuser
QLHS_APP_PASSWORD=CHANGE_ME_pg_app

# ---- PMH ID (SSO) — PHẢI khớp cụm de-admin:8443 ----
OIDC_ISSUER=https://de-admin.pmh.com.vn:8443/oidc
# PHẢI KHỚP client_id đăng ký ở PMH ID (đặt 'project-qlhs' — gạch NGANG, đồng bộ với project-qlts):
OIDC_CLIENT_ID=project-qlhs
# Lấy từ UI PMH ID khi đăng ký client QLHS:
OIDC_CLIENT_SECRET=CHANGE_ME_client_secret
OIDC_REDIRECT_URI=https://de-qlhs.pmh.com.vn:8443/api/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://de-qlhs.pmh.com.vn:8443/
WEB_ORIGIN=https://de-qlhs.pmh.com.vn:8443

# ---- Khóa mã hóa mật khẩu SMTP lưu ở DB (Admin › Cấu hình), AES-256-GCM ----
# Sinh 1 lần: openssl rand -base64 48. KHÔNG đổi sau khi đã lưu SMTP (đổi = mất giải mã).
CONFIG_ENC_KEY=CHANGE_ME_config_enc_key

# ---- Chốt nhóm đăng nhập (BẮT BUỘC ở prod — thiếu là api từ chối khởi động) ----
# Khớp với client QLHS ở PMH ID: nếu bật "Cho phép tất cả nhóm" thì đặt =1 (tin vào
# phân quyền client bên PMH ID). Hoặc khai danh sách nhóm cụ thể qua QLHS_ALLOWED_GROUPS.
QLHS_ALLOW_ALL_GROUPS=1
# QLHS_ALLOWED_GROUPS=nhom1,nhom2   (dùng cái này thay vì ALLOW_ALL nếu muốn siết theo nhóm)

# ---- (Tùy chọn) email SSO tự cấp quyền Admin khi đăng nhập (phẩy) ----
QLHS_ADMIN_EMAILS=

# ---- (Tùy chọn) webhook offboarding từ PMH ID — HMAC secret chung ----
PMH_WEBHOOK_SECRET=

# ---- Admin nội bộ (break-glass, KHÔNG qua SSO) — vào được khi PMH ID chết ----
# Mật khẩu THÔ (QLHS seed vào DB lúc boot; khác QLTS dùng hash). Cất offline.
QLHS_LOCAL_ADMIN_EMAIL=admin.ssa@local.com
QLHS_LOCAL_ADMIN_PASSWORD=CHANGE_ME_local_admin_pw
