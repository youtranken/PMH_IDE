# =========================================================================
# PMH ID (admin-de) — .env PROD. Copy sang ~/PMH_IDE/.env, KHÔNG commit.
# Điền các giá trị CHANGE_ME bằng secret sinh từ: bash gen-secrets.sh
# =========================================================================

# ---- Node ----
NODE_ENV=production

# ---- Cổng host nội bộ (KHÔNG phơi ra ngoài; edge lo 8443). Giữ khác project khác. ----
HOST_HTTP_PORT=9080
HOST_HTTPS_PORT=9443
HOST_PG_PORT=5490

# ---- Postgres (mật khẩu chỉ [A-Za-z0-9]; đổi cả DATABASE_URL cho khớp) ----
POSTGRES_USER=pmhid
POSTGRES_PASSWORD=CHANGE_ME_pg_pw
POSTGRES_DB=pmhid
DATABASE_URL=postgres://pmhid:CHANGE_ME_pg_pw@postgres:5432/pmhid

# ---- OIDC issuer — BẮT BUỘC :8443 (đổi issuer = mọi client phải cập nhật khớp cổng) ----
OIDC_ISSUER=https://admin-de.pmh.com.vn:8443/oidc

# ---- Redirect của SPA quản trị (portal) — BẮT BUỘC khai, khớp origin gồm cổng ----
PORTAL_REDIRECT_URI=https://admin-de.pmh.com.vn:8443/auth/callback

# ---- Khóa ký cookie oidc-provider (2 khóa, phẩy phân tách) ----
COOKIE_KEYS=CHANGE_ME_cookie_key_1,CHANGE_ME_cookie_key_2

# ---- KEK mã hóa TOTP/webhook/SMTP secret — MẤT KEK = MẤT HẾT. Cất offline. ----
KEK_BASE64=CHANGE_ME_kek_base64

# ---- Dải IP nội bộ được phép nhận webhook + Back-Channel Logout ----
# Cụm edge dùng subnet ghim 172.20.0.0/16 → PHẢI khai để BCL/webhook tới qlts (sau edge) đi được.
WEBHOOK_ALLOWLIST_CIDR=172.20.0.0/16

# ---- Backup ----
BACKUP_PASSPHRASE=CHANGE_ME_backup_passphrase
# Thư mục HOST chứa backup (= folder data-backups do 10-clone.sh tạo). Đổi YOUR_USER
# thành user thật; lý tưởng trỏ sang ĐĨA KHÁC với Docker/pg_data (VD /mnt/backup/pmhid).
BACKUP_DIR=/home/YOUR_USER/data-backups
BACKUP_AT=02:00

# ---- SMTP (tùy chọn; ưu tiên cấu hình ở FE: Cấu hình → Email). Fallback khi setting trống: ----
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@pmh.com.vn

# ---- Đường dẫn khóa ký JWT (khớp compose; không đổi) ----
SIGNING_KEYS_DIR=/run/secrets/signing-keys
