# =========================================================================
# QLTS — .env PROD cho cụm 8443. Copy sang ~/QLTS_DE/.env, KHÔNG commit.
# KHÁC .env.example gốc: issuer = de-admin (không phải id) và APP_BASE_URL có :8443.
# =========================================================================

# ---- Compose ----
# Chốt project='qlts' → container luôn 'qlts-*' dù repo clone thành QLTS_DE (thiếu = 'qlts_de-*',
# script backup hardcode qlts-* sẽ trật). ĐẶT TRƯỚC deploy đầu — đổi sau = volume mới, mất data.
COMPOSE_PROJECT_NAME=qlts

# ---- App ----
NODE_ENV=production
AUTH_DEV_MODE=false

# ---- Postgres (chỉ [A-Za-z0-9-_]; @ : # % phá DATABASE_URL) ----
POSTGRES_USER=qlts
POSTGRES_PASSWORD=CHANGE_ME_pg_pw
POSTGRES_DB=qlts

# ---- Redis ----
REDIS_PASSWORD=CHANGE_ME_redis_pw
# maxmemory phải < REDIS_MEM_LIMIT (512m ở dưới); policy noeviction (BullMQ yêu cầu)
REDIS_MAXMEMORY=384mb

# ---- PMH ID (SSO) — 3 giá trị dưới PHẢI khớp cụm 8443 ----
PMH_ISSUER_URL=https://de-admin.pmh.com.vn:8443/oidc
APP_BASE_URL=https://de-qlts.pmh.com.vn:8443
# client_id đặt 'project-qlts' khi đăng ký; SECRET lấy từ UI (redirect_uri = APP_BASE_URL/api/auth/callback):
PMH_CLIENT_ID=project-qlts
PMH_CLIENT_SECRET=CHANGE_ME_client_secret
# Khớp secret webhook khai ở client QLTS trong PMH ID (nếu bật offboarding webhook):
PMH_WEBHOOK_SECRET=CHANGE_ME_webhook_secret

# ---- SA cục bộ (break-glass) — BẮT BUỘC, thiếu là api từ chối khởi động ----
# Sinh hash trên prod: cd ~/QLTS_DE/api && npm run sa:hash -- '<mật-khẩu-mạnh>'
LOCAL_SA_USERNAME=sa
LOCAL_SA_PASSWORD_HASH=CHANGE_ME_scrypt.salt.hash

# ---- SMTP (tùy chọn; worker gửi mail nền) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Khóa mã hoá password SMTP khi lưu qua UI Cấu hình › Email (AES-256-GCM, dùng CHUNG api+worker).
# BẮT BUỘC nếu dùng lưu SMTP qua UI. Sinh: openssl rand -hex 32. KHÔNG đổi sau khi đã lưu password.
MAIL_ENC_KEY=CHANGE_ME_mail_enc_key

# ---- Backup (backup-cron tự chạy lúc BACKUP_AT). FAIL-CLOSED: thiếu passphrase = TỪ CHỐI
#      backup (KHÔNG tạo file plaintext). Thiếu cả nhóm này = cron fail mỗi đêm = KHÔNG có backup. ----
# BACKUP_DIR = thư mục HOST NGOÀI repo (đừng để mặc định ./data-backups trong QLTS_DE — mất khi re-clone).
BACKUP_DIR=/srv/qlts-backups
BACKUP_AT=02:00
BACKUP_KEEP_DAYS=30
# Sinh: openssl rand -hex 32 (AES-256-CBC). Cất offline — mất passphrase = mất khả năng restore.
BACKUP_PASSPHRASE=CHANGE_ME_openssl_rand_hex_32
BACKUP_ALLOW_PLAINTEXT=0

# ---- Ngân sách RAM: tổng ≤16GB cho QLTS (host prod chung IdP, ≥64GB) ----
POSTGRES_MEM_LIMIT=9216m
API_MEM_LIMIT=4096m
REDIS_MEM_LIMIT=512m
WEB_MEM_LIMIT=512m
WORKER_MEM_LIMIT=2048m
