# =========================================================================
# QLTS — .env PROD cho cụm 8443. Copy sang ~/QLTS_DE/.env, KHÔNG commit.
# KHÁC .env.example gốc: issuer = admin-de (không phải id) và APP_BASE_URL có :8443.
# =========================================================================

# ---- App ----
NODE_ENV=production
AUTH_DEV_MODE=false

# ---- Postgres (chỉ [A-Za-z0-9-_]; @ : # % phá DATABASE_URL) ----
POSTGRES_USER=qlts
POSTGRES_PASSWORD=CHANGE_ME_pg_pw
POSTGRES_DB=qlts

# ---- Redis ----
REDIS_PASSWORD=CHANGE_ME_redis_pw
REDIS_MAXMEMORY=96mb

# ---- PMH ID (SSO) — 3 giá trị dưới PHẢI khớp cụm 8443 ----
PMH_ISSUER_URL=https://admin-de.pmh.com.vn:8443/oidc
APP_BASE_URL=https://qlts.pmh.com.vn:8443
# Lấy 2 giá trị này từ UI PMH ID khi đăng ký client QLTS (redirect_uri = APP_BASE_URL/api/auth/callback):
PMH_CLIENT_ID=CHANGE_ME_client_id
PMH_CLIENT_SECRET=CHANGE_ME_client_secret
# Khớp secret webhook khai ở client QLTS trong PMH ID (nếu bật offboarding webhook):
PMH_WEBHOOK_SECRET=CHANGE_ME_webhook_secret

# ---- SA cục bộ (break-glass) — BẮT BUỘC, thiếu là api từ chối khởi động ----
# Sinh hash trên prod: cd ~/QLTS_DE/api && npm run sa:hash -- '<mật-khẩu-mạnh>'
LOCAL_SA_USERNAME=sa
LOCAL_SA_PASSWORD_HASH=CHANGE_ME_scrypt.salt.hash

# ---- SMTP (tùy chọn; worker gửi mail nền) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Ngân sách RAM (giữ mặc định trừ khi cần) ----
POSTGRES_MEM_LIMIT=512m
API_MEM_LIMIT=384m
REDIS_MEM_LIMIT=128m
WEB_MEM_LIMIT=64m
WORKER_MEM_LIMIT=256m

# ---- Chatbot Gemini (tùy chọn, để trống = tắt gõ câu tự do) ----
GEMINI_API_KEY=
