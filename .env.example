# =========================================================================
# PMH ID — .env (tầng BÍ MẬT hạ tầng, AD-15). Copy sang .env, KHÔNG commit.
# Tham số vận hành runtime (TTL, policy MK, path backup...) nằm ở bảng
# `settings` trong DB, KHÔNG ở đây.
# =========================================================================

# ---- Cổng host (né project khác; xem docs/backlog/epic-0) ----
# Mỗi project PHẢI dùng cổng host DB riêng để không đụng nhau (cổng TRONG
# container luôn là 5432, publish ra host mới cần độc nhất). Quy định: PMH ID = 5490.
HOST_HTTP_PORT=9080
HOST_HTTPS_PORT=9443
HOST_PG_PORT=5490
HOST_MAILPIT_UI_PORT=8026
HOST_MAILPIT_SMTP_PORT=1026

# ---- Postgres ----
POSTGRES_USER=pmhid
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=pmhid
# DATABASE_URL cho app trong network compose (host = tên service `postgres`)
DATABASE_URL=postgres://pmhid:change_me_dev_only@postgres:5432/pmhid

# ---- OIDC issuer (CÓ path /oidc — khớp docs tích hợp) ----
# Dev: qua Nginx TLS self-signed. Prod: https://admin-de.pmh.com.vn:8443/oidc
# Cổng công khai = 8443 nên issuer PHẢI mang :8443. Issuer đổi = MỌI client (QLTS,
# QLHS…) phải cập nhật discovery/issuer khớp y hệt, kể cả cổng.
OIDC_ISSUER=https://localhost:9443/oidc

# ---- Portal redirect (SPA quản trị) — PROD BẮT BUỘC KHAI ----
# redirect_uris + post_logout của client pmh-portal suy từ đây. Phải khớp CHÍNH XÁC
# location.origin của SPA gồm cả cổng, nếu không authorize trả invalid_redirect_uri.
# Prod: https://admin-de.pmh.com.vn:8443/auth/callback (nhiều URL phân tách bằng dấu phẩy).
PORTAL_REDIRECT_URI=

# ---- Cookie keys (ký cookie tương tác/phiên, AD-15) — mảng, xoay vòng ----
# Sinh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_KEYS=dev_cookie_key_change_me_0123456789abcdef

# ---- SMTP ----
# TẤT CẢ cấu hình SMTP giờ ở màn "Cấu hình → Email" trên FE (SSA chỉnh runtime):
# host, port, user, mật khẩu (lưu MÃ HÓA), from. Với Gmail: host=smtp.gmail.com,
# port=587, user=<gmail>, mật khẩu=<App password 16 ký tự>.
# Các biến dưới đây CHỈ là fallback khi setting tương ứng để trống (tùy chọn):
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@pmh.com.vn

# ---- Đường dẫn khóa ký JWT (file mount, KHÔNG trong DB — AD-6/AD-8) ----
SIGNING_KEYS_DIR=/run/secrets/signing-keys

# ---- KEK: mã hóa TOTP secret & webhook secret (tách khỏi ciphertext — AD-15) ----
# Sinh: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEK_BASE64=ZGV2X2tla19jaGFuZ2VfbWVfMDEyMzQ1Njc4OWFiY2Q=

# ---- Dải IP nội bộ được phép NHẬN webhook + Back-Channel Logout (CIDR, phẩy) ----
# Chống SSRF: mặc định PMH ID CHẶN mọi IP private. App on-prem (qlts…) ở IP nội bộ
# thì phải khai dải của chúng ở đây, nếu không webhook/BCL không gửi tới được.
# Trống = chỉ gửi tới IP public. VD: 10.0.0.0/8,192.168.0.0/16,172.16.0.0/12
# LƯU Ý (mô hình EDGE): webhook tới app sau edge (vd https://qlts.pmh.com.vn) sẽ resolve
# ra IP nginx EDGE trên mạng docker "edge" → PHẢI khai dải mạng edge (vd 172.20.0.0/16).
# Xem `docker network inspect edge` để lấy subnet thật (Docker tự cấp; nên pin cố định).
WEBHOOK_ALLOWLIST_CIDR=

# ---- Backup (E3-S1): passphrase mã hóa archive at-rest ----
# Sinh: node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
# CẤT OFFLINE: mất passphrase = không giải mã được BẤT KỲ bản backup nào.
BACKUP_PASSPHRASE=dev_backup_passphrase_change_me

# Thư mục HOST chứa backup. PHẢI khác đĩa với Docker/pg_data — để mặc định
# (named volume) thì hỏng đĩa là mất CẢ database LẪN toàn bộ backup.
# Windows dùng gạch chéo xuôi. Trống → ../../backup-pmhid cạnh repo.
BACKUP_DIR=F:/PMH/backup-pmhid

# Mốc chạy backup tự động hằng ngày (service backup-cron, giờ container).
BACKUP_AT=02:00

# ---- Node env ----
NODE_ENV=development
